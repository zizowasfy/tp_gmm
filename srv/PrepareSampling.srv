# Immutable, single-plan model and proposal settings. All lengths are SI units.
GaussianMixture model
string group_name
string link_name
string mode
geometry_msgs/Quaternion orientation
uint32 seed
float64 cutoff 2.0
float64 covariance_floor 1e-8
float64 uniform_fraction 0.1
float64 cartesian_fraction 0.1
float64 ik_timeout 0.005
uint32 branches 3
uint32 anchor_attempts 16
float64 nullspace_stddev 0.08
float64 max_joint_delta 0.6
float64 linearization_tolerance 0.01
bool visualize
# Proposal selection is orthogonal to mapping; path proposals currently require cartesian_ik.
string proposal "gmm"
# Request-matched positions in exactly model.header.frame_id; orientations ignored.
geometry_msgs/PoseArray reference_path
float64 gmr_stddev 0.01
float64 gmr_cutoff 2.0
# Probability of choosing GMR rather than GMM in hybrid mode, after uniform fallback.
float64 gmr_fraction 0.8
---
bool success
string message
string request_id
moveit_msgs/Constraints constraints
