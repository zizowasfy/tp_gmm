string task_name
string frame_id
# w.r.t. the robot used in demonstrations
geometry_msgs/PoseStamped tpgmm_start_pose 
geometry_msgs/PoseStamped tpgmm_goal_pose 
# w.r.t. the robot used in RL training
geometry_msgs/PoseStamped deformed_tpgmm_start_pose
geometry_msgs/PoseStamped deformed_tpgmm_goal_pose
geometry_msgs/PoseStamped obstacle_pose
float32 obstacle_radius
float32 desired_clearance
---
tp_gmm/GaussianMixture original_gmm
tp_gmm/GaussianMixture deformed_gmm
# Disjoint wall-clock stages. RL includes input preparation, inference and mean update.
float64 model_load_s
float64 reproduction_s
float64 rl_deformation_s
float64 deformed_regression_s
float64 total_s
bool policy_applied
