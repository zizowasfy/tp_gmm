+bool ompl_interface::ConstrainedSampler::sampleConstrained(ob::State* state)
+{
+  const auto& config = planning_context_->getSpecificationConfig();
+  const auto strict = config.find("allow_constraint_sampler_fallback");
+  const bool allow_fallback = strict == config.end() || (strict->second != "false" && strict->second != "0");
+  if (allow_fallback)
+    return sampleC(state) || sampleC(state) || sampleC(state);
+  // The void OMPL StateSampler API cannot return "no sample". Retry only the
+  // configured sampler, then propagate a controlled timeout; never draw default_.
+  while (!planning_context_->isSamplingTerminated())
+    if (sampleC(state)) return true;
+  throw ConstraintSamplingTimeout();
+}
